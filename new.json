---
layout: null
permalink: /new.json
sitemap: false
---
{%- comment -%} پایه‌ی صفحه‌ی «تازه‌ها». آمار زنده را خود صفحه از GitHub می‌خواند؛ این‌ها نسخه‌ی لحظه‌ی دیپلوی است. {%- endcomment -%}
[
{%- for p in site.podcasts -%}
{%- assign st = site.data.rss_stats[p.slug] -%}
{
  "slug": {{ p.slug | jsonify }},
  "title": {{ p.title | jsonify }},
  "logo": {% if p.logo and p.logo contains '://' %}{{ p.logo | jsonify }}{% elsif p.logo %}{{ p.logo | relative_url | jsonify }}{% else %}""{% endif %},
  "url": {{ p.url | relative_url | jsonify }},
  "category": {{ p.category | default: "سایر" | jsonify }},
  "last_at": {{ st.last_at | default: null | jsonify }},
  "last_title": {{ st.last_title | default: null | jsonify }},
  "last_link": {{ st.last_link | default: null | jsonify }},
  "recent": {{ st.recent | default: null | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
