diff --git a/assets/css/pp-compare.css b/assets/css/pp-compare.css
new file mode 100644
index 0000000..4b84759
--- /dev/null
+++ b/assets/css/pp-compare.css
@@ -0,0 +1,67 @@
+/* PersianPod: صفحه‌ی مقایسه. بدون رنگ «برنده»؛ هر دو پادکست یکسان نمایش داده می‌شوند. */
+.cp-pick{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:start;margin-top:14px}
+.cp-vs{align-self:center;color:var(--mut);font-size:.9rem;padding-top:26px}
+.cp-slot label{display:block;margin:0 0 6px;font-weight:700}
+.cp-box{position:relative}
+.cp-box input{width:100%;min-height:46px;padding:0 14px;border:1px solid var(--line);border-radius:14px;background:var(--card);color:var(--ink);font:inherit}
+.cp-box input:focus-visible{outline:3px solid #08cb00;outline-offset:2px}
+.cp-list{position:absolute;inset-inline:0;top:calc(100% + 6px);z-index:30;margin:0;padding:6px;list-style:none;max-height:300px;overflow:auto;
+  border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 12px 30px var(--glow-soft)}
+.cp-list li{display:flex;justify-content:space-between;gap:10px;padding:9px 12px;border-radius:10px;cursor:pointer}
+.cp-list li small{color:var(--mut)}
+.cp-list li:hover,.cp-list li[aria-selected=true]{background:var(--line)}
+.cp-list .cp-none{cursor:default;color:var(--mut)}
+.cp-chosen:not(:empty){display:flex;align-items:center;gap:10px;margin-top:10px;padding:10px 12px;border:1px solid #08cb00;border-radius:16px;background:var(--card)}
+.cp-lg,.cp-hl{flex:none;width:44px;height:44px;border-radius:12px;object-fit:cover;display:grid;place-items:center;background:var(--line);color:var(--acc);font-style:normal;font-weight:800}
+.cp-chosen b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.cp-x{flex:none;width:32px;height:32px;border:0;border-radius:50%;background:transparent;color:var(--mut);font-size:1.3rem;cursor:pointer}
+.cp-x:hover{background:var(--line)}
+.cp-x:focus-visible,.cp-btn:focus-visible,.cp-i:focus-visible{outline:3px solid #08cb00;outline-offset:2px}
+.cp-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
+.cp-btn{min-height:44px;padding:0 22px;border:0;border-radius:999px;background:#08cb00;color:#0b0e0c;font:inherit;font-weight:800;cursor:pointer}
+.cp-btn.cp-ghost{background:transparent;color:var(--ink);border:1px solid var(--line);font-weight:600}
+.cp-btn:disabled{opacity:.45;cursor:not-allowed}
+.cp-msg{min-height:1.4em;color:var(--mut)}
+
+.cp-head{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin:22px 0 14px}
+.cp-hp{display:flex;align-items:center;gap:12px;min-width:0}
+.cp-hp h2{margin:0;font-size:clamp(1rem,2.4vw,1.3rem);line-height:1.6}
+.cp-hp a{color:var(--ink);text-decoration:none}
+.cp-hp a:hover{text-decoration:underline}
+.cp-hl{width:64px;height:64px;border-radius:16px;font-size:1.6rem}
+.cp-hvs{color:var(--mut);font-size:1.3rem}
+.cp-card{margin:14px 0;padding:16px;border:1px solid var(--line);border-radius:22px;background:var(--card)}
+.cp-card h2{margin:0 0 10px;font-size:1.1rem}
+.cp-card ul{margin:0;padding-inline-start:1.2em;line-height:2}
+.cp-scroll{overflow-x:auto}
+.cp-t{width:100%;border-collapse:collapse;min-width:520px}
+.cp-t th,.cp-t td{padding:11px 10px;text-align:start;vertical-align:top;border-bottom:1px solid var(--line)}
+.cp-t thead th{font-size:.95rem}
+.cp-t tbody th[scope=row]{width:30%;font-weight:600;color:var(--mut);position:relative}
+.cp-t .cp-g th{padding-top:20px;color:var(--ink);font-size:.95rem;border-bottom:2px solid var(--line)}
+.cp-t td{position:relative}
+.cp-bar{display:block;height:8px;margin-top:6px;border-radius:99px;background:var(--line);overflow:hidden}
+.cp-bar span{display:block;height:100%;border-radius:99px;background:#08cb00;opacity:.75}
+.cp-na{color:var(--mut);font-size:.85rem}
+.cp-i{margin-inline-start:6px;border:0;background:transparent;color:var(--mut);font:inherit;cursor:pointer;padding:0 4px;border-radius:6px}
+.cp-i:hover,.cp-i[aria-expanded=true]{color:var(--acc)}
+.cp-tip{margin-top:6px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);font-size:.85rem;font-weight:400;line-height:1.9}
+
+.cp-tr-row{display:grid;grid-template-columns:140px 1fr;gap:12px;align-items:end;margin:10px 0}
+.cp-tr-row b{font-size:.9rem;overflow:hidden;text-overflow:ellipsis}
+.cp-cols{display:flex;align-items:flex-end;gap:5px;height:70px;border-bottom:1px solid var(--line)}
+.cp-col{flex:1;min-height:3px;border-radius:5px 5px 0 0;background:#08cb00;opacity:.8}
+.cp-tr-row.b .cp-col{background:transparent;border:2px solid #08cb00;border-bottom:0;opacity:1}
+.cp-axis{display:flex;justify-content:space-between;margin:4px 0 0;color:var(--mut);font-size:.78rem;padding-inline-start:152px}
+.cp-note{color:var(--mut);font-size:.9rem;line-height:1.9}
+.cp-needs li{list-style:none;margin-inline-start:-1.2em}
+.cp-foot{text-align:center;margin:16px 0}
+
+.cp-method{margin-top:36px;padding-top:6px;border-top:1px solid var(--line);scroll-margin-top:84px;line-height:2}
+.cp-method h2{font-size:1.2rem}.cp-method h3{font-size:1rem;margin:16px 0 4px}
+
+@media(max-width:700px){
+  .cp-pick{grid-template-columns:1fr}.cp-vs{display:none}
+  .cp-head{grid-template-columns:1fr}.cp-hvs{display:none}
+  .cp-tr-row{grid-template-columns:1fr}.cp-axis{padding-inline-start:0}
+}
diff --git a/assets/css/pp-float-player.css b/assets/css/pp-float-player.css
index e3af7f5..6597b3a 100644
--- a/assets/css/pp-float-player.css
+++ b/assets/css/pp-float-player.css
@@ -186,3 +186,51 @@ body.night .ppfp {
     transition: box-shadow 0.2s ease;
   }
 }
+
+/* پیام بارگذاری / خطا و دکمه‌ی بارگذاری دوباره */
+.ppfp__status {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  padding: 14px;
+  direction: rtl;
+  text-align: center;
+  background: var(--ppfp-bg);
+  color: var(--ppfp-fg);
+  z-index: 1;
+}
+.ppfp__status[hidden] { display: none; }
+.ppfp__msg { margin: 0; font-size: 13px; line-height: 1.8; }
+.ppfp__acts { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
+.ppfp__retry, .ppfp__ext {
+  display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px;
+  border-radius: 999px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: none;
+}
+.ppfp__retry { border: 0; background: var(--ppfp-green); color: #0b0e0c; }
+.ppfp__ext { border: 1px solid var(--ppfp-line); color: inherit; background: transparent; }
+.ppfp__retry:focus-visible, .ppfp__ext:focus-visible { outline: 2px solid var(--ppfp-green); outline-offset: 2px; }
+.ppfp__retry[hidden], .ppfp__ext[hidden] { display: none; }
+.ppfp__reload { font-size: 18px; }
+.ppfp--min .ppfp__status { display: none; }
+
+/* پوستر پخش در صفحه‌ی پادکست و «گوش بده» */
+.pp-poster { text-align: center; }
+.pp-poster-note { margin: 0 0 12px; color: var(--mut); font-size: .9rem; }
+.pp-poster-btn {
+  display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 24px;
+  border: 0; border-radius: 999px; background: #08cb00; color: #0b0e0c; font: inherit; font-weight: 800; cursor: pointer;
+  transition: box-shadow .2s ease;
+}
+.pp-poster-btn svg { width: 18px; height: 18px; fill: currentColor; }
+.pp-poster-btn:hover { box-shadow: 0 6px 20px #00ff9c66; }
+.pp-poster-btn:focus-visible { outline: 3px solid #08cb00; outline-offset: 3px; }
+
+/* موبایل: پلیر روی انتهای محتوا نیفتد */
+@media (max-width: 600px) {
+  body.ppfp-open { padding-bottom: 236px; }
+  body.ppfp-open.ppfp-min { padding-bottom: 60px; }
+}
diff --git a/assets/js/pp-compare.js b/assets/js/pp-compare.js
new file mode 100644
index 0000000..5b3d8c7
--- /dev/null
+++ b/assets/js/pp-compare.js
@@ -0,0 +1,215 @@
+/* PersianPod: صفحه‌ی «مقایسه‌ی اطلاعات پادکست‌ها»
+   اصل: فقط داده‌ی قابل اندازه‌گیری؛ بدون امتیاز، بدون برنده، بدون قضاوت درباره‌ی کیفیت.
+   هر عدد یک توضیح «ⓘ» دارد تا معلوم باشد از کجا آمده. */
+(function () {
+  "use strict";
+  var $ = function (s, r) { return (r || document).querySelector(s); };
+  var out = $("#cp-out");
+  if (!out) return;
+
+  var FA = "۰۱۲۳۴۵۶۷۸۹", AR = "٠١٢٣٤٥٦٧٨٩";
+  function toFa(n) { return String(n).replace(/\d/g, function (d) { return FA[d]; }); }
+  function norm(s) {
+    return String(s == null ? "" : s).replace(/[يى]/g, "ی").replace(/ك/g, "ک").replace(/[\u064B-\u065F\u0670]/g, "")
+      .replace(/\u200c/g, " ").replace(/\s+/g, " ")
+      .replace(/[۰-۹]/g, function (d) { return FA.indexOf(d); }).replace(/[٠-٩]/g, function (d) { return AR.indexOf(d); })
+      .toLowerCase().trim();
+  }
+  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
+  function num(v) {                                   // عدد یا متنی مثل «۴۰ دقیقه»
+    if (v == null || v === "") return null;
+    var m = String(v).replace(/[۰-۹]/g, function (d) { return FA.indexOf(d); }).match(/\d+(\.\d+)?/);
+    return m ? parseFloat(m[0]) : null;
+  }
+  function fmt(n) { return toFa(Math.round(n * 10) / 10).replace(".", "٫"); }
+
+  var STATUS = { active: "فعال", paused: "متوقف", inactive: "غیرفعال", ended: "پایان‌یافته" };
+  var data = [], sel = { a: null, b: null };
+
+  /* ---------- تعریف شاخص‌ها ----------
+     k: کلید، v: مقدار عددی (برای میله و تفاوت)، t: متن نمایشی، i: توضیح شفاف محاسبه */
+  var METRICS = [
+    { g: "اطلاعات پایه", rows: [
+      { l: "دسته‌بندی", t: function (p) { return p.category; }, i: "دسته‌ای که پادکستر هنگام ثبت انتخاب کرده است." },
+      { l: "موضوع‌ها", t: function (p) { return (p.subcategories || []).join("، "); }, i: "زیردسته‌هایی که پادکستر ثبت کرده است." },
+      { l: "وضعیت", t: function (p) { return STATUS[p.status] || ""; }, i: "اگر RSS ثبت شده باشد، بر اساس تاریخ آخرین قسمت (بیش از ۳ سال بدون قسمت جدید = غیرفعال)؛ وگرنه مقدارِ ثبت‌شده توسط پادکستر." },
+      { l: "سال شروع", v: function (p) { return num(p.start); }, t: function (p) { return p.start ? toFa(p.start) : ""; }, i: "سال شمسی اولین قسمت در RSS، یا سالی که پادکستر ثبت کرده است." },
+      { l: "شهر و کشور", t: function (p) { return [p.city, p.country].filter(Boolean).join("، "); }, i: "اطلاعات ثبت‌شده توسط پادکستر." },
+      { l: "زبان", t: function (p) { return p.language; }, i: "اطلاعات ثبت‌شده توسط پادکستر." }
+    ] },
+    { g: "انتشار", rows: [
+      { l: "تعداد کل قسمت‌ها", v: function (p) { return num(p.episodes); }, t: function (p) { return p.episodes != null ? toFa(p.episodes) : ""; }, bar: 1, i: "تعداد قسمت‌های موجود در RSS (یا عددی که پادکستر ثبت کرده). این عدد به سن پادکست وابسته است؛ برای مقایسه‌ی عادلانه‌تر، ردیف‌های ۱۲ ماه اخیر را هم ببینید." },
+      { l: "قسمت‌های ۱۲ ماه اخیر", v: function (p) { return num(p.eps_365); }, t: function (p) { return p.eps_365 != null ? toFa(p.eps_365) : ""; }, bar: 1, i: "تعداد قسمت‌هایی که در ۳۶۵ روز گذشته منتشر شده‌اند (از RSS)." },
+      { l: "قسمت‌های ۹۰ روز اخیر", v: function (p) { return num(p.eps_90); }, t: function (p) { return p.eps_90 != null ? toFa(p.eps_90) : ""; }, bar: 1, i: "تعداد قسمت‌هایی که در ۹۰ روز گذشته منتشر شده‌اند (از RSS)." },
+      { l: "میانگین فاصله‌ی انتشار", v: function (p) { return num(p.gap); }, t: function (p) { return p.gap != null ? "هر " + fmt(p.gap) + " روز" : ""; }, i: "فاصله‌ی قسمت اول تا آخرِ ۳۶۵ روز گذشته تقسیم بر تعداد فاصله‌ها. اگر در این بازه کمتر از دو قسمت باشد، محاسبه نمی‌شود." },
+      { l: "آخرین قسمت", t: function (p) { return p.last ? toFa(p.last) : ""; }, i: "تاریخ شمسی آخرین قسمت در RSS." }
+    ] },
+    { g: "مدت قسمت‌ها", rows: [
+      { l: "میانگین مدت قسمت", v: function (p) { return num(p.avg_length); }, t: function (p) { var n = num(p.avg_length); return n != null ? toFa(Math.round(n)) + " دقیقه" : ""; }, bar: 1, i: "میانگین مدت ۳۰ قسمت آخر که مدت معتبر دارند." },
+      { l: "میانه‌ی مدت قسمت", v: function (p) { return num(p.median_length); }, t: function (p) { return p.median_length != null ? toFa(p.median_length) + " دقیقه" : ""; }, bar: 1, i: "میانه‌ی مدت همه‌ی قسمت‌های RSS که مدت معتبر دارند. میانه به قسمت‌های خیلی کوتاه یا خیلی بلند حساس نیست." },
+      { l: "کوتاه‌ترین قسمت", v: function (p) { return num(p.min_length); }, t: function (p) { return p.min_length != null ? toFa(p.min_length) + " دقیقه" : ""; }, i: "کوتاه‌ترین قسمتِ دارای مدت معتبر در RSS." },
+      { l: "بلندترین قسمت", v: function (p) { return num(p.max_length); }, t: function (p) { return p.max_length != null ? toFa(p.max_length) + " دقیقه" : ""; }, i: "بلندترین قسمتِ دارای مدت معتبر در RSS." }
+    ] }
+  ];
+
+  /* ---------- انتخاب پادکست ---------- */
