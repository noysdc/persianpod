---
layout: null
permalink: /compare.json
sitemap: false
---
{%- comment -%} داده‌ی صفحه‌ی «مقایسه»: فقط اطلاعات قابل اندازه‌گیری. آمار RSS از scripts/update_rss.py می‌آید. {%- endcomment -%}
[
{%- for p in site.podcasts -%}
{%- assign st = site.data.rss_stats[p.slug] -%}
{%- assign stv = p.status_override | default: st.status | default: p.status | default: "active" -%}
{%- if stv == "فعال" -%}{%- assign stv = "active" -%}{%- elsif stv == "متوقف" -%}{%- assign stv = "paused" -%}{%- elsif stv == "تمام‌شده" -%}{%- assign stv = "ended" -%}{%- endif -%}
{
  "slug": {{ p.slug | jsonify }},
  "title": {{ p.title | jsonify }},
  "logo": {% if p.logo and p.logo contains '://' %}{{ p.logo | jsonify }}{% elsif p.logo %}{{ p.logo | relative_url | jsonify }}{% else %}""{% endif %},
  "url": {{ p.url | relative_url | jsonify }},
  "category": {{ p.category | default: "سایر" | jsonify }},
  "subcategories": {% if p.subcategories %}{{ p.subcategories | jsonify }}{% elsif p.subcategory %}[{{ p.subcategory | jsonify }}]{% else %}[]{% endif %},
  "city": {{ p.city | jsonify }},
  "country": {{ p.country | jsonify }},
  "language": {{ p.language | jsonify }},
  "status": {{ stv | jsonify }},
  "start": {{ st.first_year | default: p.start_year | default: p.started | default: null | jsonify }},
  "episodes": {{ st.episodes | default: p.episode_count | default: p.episodes | default: null | jsonify }},
  "last": {{ st.last | default: p.last_episode | default: null | jsonify }},
  "avg_length": {{ st.avg_length | default: p.avg_length | default: null | jsonify }},
  "median_length": {{ st.median_length | default: null | jsonify }},
  "min_length": {{ st.min_length | default: null | jsonify }},
  "max_length": {{ st.max_length | default: null | jsonify }},
  "eps_90": {{ st.eps_90 | default: null | jsonify }},
  "eps_365": {{ st.eps_365 | default: null | jsonify }},
  "gap": {{ st.avg_gap_days | default: null | jsonify }},
  "recent_30d": {{ st.recent_30d | default: null | jsonify }},
  "has_rss": {% if st %}true{% else %}false{% endif %}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
