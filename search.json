---
layout: null
---
[{% for p in site.podcasts %}{% assign st = site.data.rss_stats[p.slug] %}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"description":{{ p.description | jsonify }},"category":{{ p.category | jsonify }},"subcategory":{{ p.subcategory | jsonify }},"tags":{{ p.tags | jsonify }},"status":{{ p.status_override | default: st.status | default: p.status | default: "active" | jsonify }},"language":{{ p.language | jsonify }},"city":{{ p.city | jsonify }},"country":{{ p.country | jsonify }},"creator":{{ p.creator | jsonify }},"episodes":{{ st.episodes | default: p.episode_count | default: 0 | jsonify }},"start":{{ st.first_year | default: p.start_year | default: 0 | jsonify }},"length":{{ st.avg_length | default: p.avg_length | default: p.duration | jsonify }},"last":{{ st.last | default: p.last_episode | jsonify }},"slug":{{ p.slug | jsonify }},"spotify":{{ p.spotify | jsonify }},"apple":{{ p.apple | jsonify }},"embed":{{ p.embed | jsonify }},"website":{{ p.website | jsonify }},"logo":{% if p.logo and p.logo contains '://' %}{{ p.logo | jsonify }}{% elsif p.logo %}{{ p.logo | relative_url | jsonify }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
