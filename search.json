---
layout: null
---
[{% for p in site.podcasts %}{% assign st = site.data.rss_stats[p.slug] %}{%- assign stv = p.status_override | default: st.status | default: p.status | default: "active" -%}
{%- if stv == "فعال" -%}{%- assign stv = "active" -%}{%- elsif stv == "متوقف" -%}{%- assign stv = "paused" -%}{%- elsif stv == "تمام‌شده" -%}{%- assign stv = "ended" -%}{%- endif -%}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"description":{{ p.description | jsonify }},"category":{{ p.category | jsonify }},"subcategory":{{ p.subcategory | jsonify }},"tags":{{ p.tags | jsonify }},"status":{{ stv | jsonify }},"language":{{ p.language | jsonify }},"city":{{ p.city | jsonify }},"country":{{ p.country | jsonify }},"creator":{{ p.creator | default: p.host | default: p.hosts | jsonify }},"episodes":{{ st.episodes | default: p.episode_count | default: p.episodes | default: 0 | jsonify }},"start":{{ st.first_year | default: p.start_year | default: p.started | default: 0 | jsonify }},"length":{{ st.avg_length | default: p.avg_length | default: p.duration | jsonify }},"last":{{ st.last | default: p.last_episode | jsonify }},"slug":{{ p.slug | jsonify }},"logo":{% if p.logo and p.logo contains '://' %}{{ p.logo | jsonify }}{% elsif p.logo %}{{ p.logo | relative_url | jsonify }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
