---
layout: null
---
[{% for p in site.podcasts %}{% assign st = site.data.rss_stats[p.slug] %}{%- assign stv = p.status_override | default: st.status | default: p.status | default: "active" -%}
{%- if stv == "فعال" -%}{%- assign stv = "active" -%}{%- elsif stv == "متوقف" -%}{%- assign stv = "paused" -%}{%- elsif stv == "تمام‌شده" -%}{%- assign stv = "ended" -%}{%- endif -%}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"description":{{ p.description | jsonify }},"category":{{ p.category | jsonify }},"subcategory":{{ p.subcategory | default: p.subcategories[0] | jsonify }},"subcategories":{% if p.subcategories %}{{ p.subcategories | jsonify }}{% elsif p.subcategory %}[{{ p.subcategory | jsonify }}]{% else %}[]{% endif %},"tags":{{ p.tags | jsonify }},"status":{{ stv | jsonify }},"language":{{ p.language | jsonify }},"city":{{ p.city | jsonify }},"country":{{ p.country | jsonify }},"creator":{{ p.creator | default: p.host | default: p.hosts | jsonify }},"title_en":{{ p.title_en | jsonify }},"host":{{ p.host | jsonify }},"body":{{ p.content | strip_html | strip_newlines | normalize_whitespace | split: " " | uniq | join: " " | truncate: 8000 | jsonify }},"episodes":{{ st.episodes | default: p.episode_count | default: p.episodes | default: 0 | jsonify }},"start":{{ st.first_year | default: p.start_year | default: p.started | default: 0 | jsonify }},"length":{{ st.avg_length | default: p.avg_length | default: p.duration | jsonify }},"last":{{ st.last | default: p.last_episode | jsonify }},"last_at":{{ st.last_at | jsonify }},"slug":{{ p.slug | jsonify }},"logo":{% if p.logo and p.logo contains '://' %}{{ p.logo | jsonify }}{% elsif p.logo %}{{ p.logo | relative_url | jsonify }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
