---
layout: null
---
[{% for p in site.podcasts %}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"description":{{ p.description | jsonify }},"category":{{ p.category | jsonify }},"subcategory":{{ p.subcategory | jsonify }},"tags":{{ p.tags | jsonify }},"status":{{ p.status | jsonify }},"language":{{ p.language | jsonify }},"city":{{ p.city | jsonify }},"country":{{ p.country | jsonify }},"creator":{{ p.creator | jsonify }},"episodes":{{ p.episode_count | default: 0 | jsonify }},"start":{{ p.start_year | default: 0 | jsonify }},"last":{{ p.last_episode | jsonify }},"logo":{% if p.logo and p.logo contains '://' %}{{ p.logo | jsonify }}{% elsif p.logo %}{{ p.logo | relative_url | jsonify }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
