---
layout: null
permalink: /podcasts.json
---
{%- comment -%}
  نسخه‌ی به‌روز: آمار RSS (از _data/rss_stats.json که GitHub Action می‌سازد) بر مقدار دستی اولویت دارد،
  مگر اینکه در front matter پادکست status_override گذاشته باشی.
  فیلدهای اختیاری تازه: castbox (لینک/شناسه)، castbox_embed (آدرس کامل embed)، youtube (لینک یک قسمت)، rss
{%- endcomment -%}
[
{%- for p in site.podcasts -%}
{%- assign st = site.data.rss_stats[p.slug] -%}
{
  "id": {{ p.slug | default: forloop.index | jsonify }},
  "title": {{ p.title | jsonify }},
  "description": {{ p.description | default: p.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},
  "logo": {{ p.logo | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "year": {{ p.year | default: st.first_year | default: null | jsonify }},
  "episodes": {{ st.episodes | default: p.episodes | default: null | jsonify }},
  "length": {{ st.avg_length | default: p.avg_length | default: null | jsonify }},
  "last": {{ st.last | default: null | jsonify }},
  "status": {{ p.status_override | default: st.status | default: p.status | default: "active" | jsonify }},
  "category": {{ p.category | default: "سایر" | jsonify }},
  "tags": {{ p.tags | default: empty | jsonify }},
  "city": {{ p.city | jsonify }},
  "country": {{ p.country | jsonify }},
  "castbox": {{ p.castbox | jsonify }},
  "castbox_embed": {{ p.castbox_embed | jsonify }},
  "youtube": {{ p.youtube | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
